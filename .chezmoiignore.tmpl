# Claude Code runtime state, not configuration: usageCount, costUSD, cache token counters,
# experiment ids, anonymousId and the path of every project ever opened. It is rewritten on
# every launch, so managing it produced ~2000 lines of permanent, meaningless drift that hid
# real divergence in `chezmoi status`.
.claude.json

# Generated code-intelligence artifacts (graph.json alone drifts by ~3300 lines). Rebuild them
# with `npx gitnexus analyze` / `graphify update .` instead of syncing them between machines.
graphify-out/

# Vendor files, not configuration: the omo Codex plugin ships these agent definitions and
# reinstalls them on every update, so the live copies are byte-identical to
# ~/.codex/plugins/cache/sisyphuslabs/omo/<version>/components/ultrawork/agents/. Managing them
# meant the repo pinned stale snapshots, and `chezmoi apply` would silently downgrade the agents
# (gpt-5.6-* back to gpt-5.5, dynamic attempt-dir artifact paths back to fixed ones).
.codex/agents/

# Holds `export CLAUDE_CODE_OAUTH_TOKEN=...`, which exists only in the live file — the template
# has no such line. Without this rule `chezmoi apply` deletes the export, and because
# dot_claude/settings.json.tmpl reads that token via `env`, the following apply then strips it
# from ~/.claude/settings.json too, breaking authentication.
.zsh_env_vars


# The notetaker LaunchAgent points at a machine-specific project checkout
# (~/Developer/Pers/notetaker/.venv). On a machine without that checkout the
# plist would fail-loop under KeepAlive, so only manage it where the binary
# exists.
{{ if not (stat (joinPath .chezmoi.homeDir "Developer/Pers/notetaker/.venv/bin/notetaker")) }}
Library/LaunchAgents/com.barsotti.notetaker.plist
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
.config/homebrew
.config/karabiner
.hammerspoon
Library
.Library
{{ end }}

{{ if eq .machine.purpose "work" }}
.config/qmd/
{{ end }}

# The journal LaunchAgent (07:00 weekday "ensure-today") is a work-only routine.
# On personal machines skip both the plist and its bootstrap script so the daemon
# never loads. The manual journal CLI and /log, /plan, /retro skills still work.
{{ if ne .machine.purpose "work" }}
Library/LaunchAgents/com.barsotti.journal.plist
.chezmoiscripts/12_setup_journal.sh
{{ end }}

# The /follow-up-jira skill watches a ticket for the reporter's validation.
# Only work machines have a Jira instance, so skip it elsewhere.
{{ if ne .machine.purpose "work" }}
.claude/skills/follow-up-jira
{{ end }}
