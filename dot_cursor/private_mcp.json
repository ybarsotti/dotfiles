{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": ["mcp-proxy-for-aws@latest", "https://aws-mcp.us-east-1.api.aws/mcp", "--metadata", "INSTALL_SOURCE=aws-cli"]
    },
    "ai-memory": {
      "url": "http://127.0.0.1:49374/mcp"
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@latest",
        "mcp"
      ]
    }
  }
}
