#!/usr/bin/env python3
"""Run local test commands in a small number of slots, without a worker pool.

A command waits in the queue for a free slot, up to TEST_LOCAL_WAIT seconds (default 540),
so an agent does not need its own retry loop. TEST_LOCAL_SLOTS (default 2) sets how many
commands run at the same time on this machine. Each command still runs serially inside.

A repository can set test variables for every worktree in `<git common dir>/test-local.env`
(one KEY=VALUE per line). The file lives inside `.git`, so it is never committed, and each
worktree finds it. Use it, for example, to turn on a migrated template database, so that a
focused run does not apply every migration again. The key TEST_LOCAL_IGNORE_ARGS lists
arguments to drop, separated by spaces: with a template database, `--create-db` only forces
a rebuild that the template already does when a migration changes.
"""

import fcntl
import os
import re
import subprocess
import sys
import time
from pathlib import Path

COMMANDS = {
    "pytest": ("uv", "run", "--no-sync", "pytest", "-p", "no:xdist", "-p", "no:xdist.looponfail"),
    "jest": ("pnpm", "exec", "jest", "--runInBand"),
    "vitest": ("pnpm", "exec", "vitest", "run", "--no-file-parallelism", "--maxConcurrency=1"),
    "playwright": ("pnpm", "exec", "playwright", "test", "--workers=1"),
}
OVERRIDE = re.compile(
    r"^(?:-n|-w|-d|-f|-o|-g|-p|-c)"
    r"|^--(?:numprocesses|dist|tx|maxWorkers|max-workers|minWorkers|min-workers|"
    r"maxConcurrency|max-concurrency|fileParallelism|file-parallelism|"
    r"no-file-parallelism|workers|fully-parallel|fullyParallel|experimental-worker|"
    r"watch|watchAll|watch-all|ui|looponfail|config-file|override-ini)(?:=|$)"
)
PYTEST_ONLY_SHORT = ("-n", "-d", "-f", "-p", "-o")
NODE_ONLY_SHORT = ("-w",)


def conflicting_flag(runner, arg):
    if not arg.startswith("-"):
        return False
    if arg.startswith("--"):
        return bool(OVERRIDE.search(arg))
    return arg.startswith(PYTEST_ONLY_SHORT if runner == "pytest" else NODE_ONLY_SHORT)


def repo_env():
    try:
        common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                capture_output=True, text=True, check=True).stdout.strip()
        lines = (Path(common) / "test-local.env").read_text().splitlines()
    except (OSError, subprocess.CalledProcessError):
        return {}
    pairs = (line.split("=", 1) for line in lines if "=" in line and not line.lstrip().startswith("#"))
    return {k.strip(): v.strip() for k, v in pairs}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print("Usage: test-local {pytest|jest|vitest|playwright} [test selectors and options]", file=sys.stderr)
        return 64
    runner, *args = sys.argv[1:]
    for arg in args:
        if conflicting_flag(runner, arg):
            print(f"test-local: {arg} conflicts with the local test limit; remove it.", file=sys.stderr)
            return 64
    env = {**repo_env(), **os.environ}
    ignored = set(env.get("TEST_LOCAL_IGNORE_ARGS", "").split())
    if ignored & set(args):
        print(f"test-local: dropped {' '.join(sorted(ignored & set(args)))} (TEST_LOCAL_IGNORE_ARGS in test-local.env).",
              file=sys.stderr)
        args = [a for a in args if a not in ignored]
    state = Path.home() / ".cache" / "test-local"
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    slots = max(1, int(os.environ.get("TEST_LOCAL_SLOTS", "2")))
    deadline = time.monotonic() + int(os.environ.get("TEST_LOCAL_WAIT", "540"))
    said = False
    while True:
        for n in range(slots):
            lock = (state / f"run.{n}.lock").open("a")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                lock.close()
        else:
            if time.monotonic() > deadline:
                print("test-local: every slot stayed busy; try again after a run exits.", file=sys.stderr)
                return 75
            if not said:
                print(f"test-local: all {slots} slots are busy; waiting in the queue.", file=sys.stderr, flush=True)
                said = True
            time.sleep(3)
            continue
        break
    with lock:
        try:
            result = subprocess.run([*COMMANDS[runner], *args], check=False, pass_fds=(lock.fileno(),),
                                    env=env)
        except FileNotFoundError as exc:
            print(f"test-local: {exc}", file=sys.stderr)
            return 127
        except KeyboardInterrupt:
            return 130
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == "__main__":
    sys.exit(main())
