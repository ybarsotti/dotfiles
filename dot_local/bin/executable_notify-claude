#!/usr/bin/env bash
set -euo pipefail

title="Claude"
subtitle=$(basename "$(pwd)")
message=$(/opt/homebrew/bin/jq -r '(.message // .last_assistant_message // "Done") | tostring | .[:240]' 2>/dev/null || printf 'Done')
[ -z "$message" ] && message="Done"

osascript - "$message" "$title" "$subtitle" <<'APPLESCRIPT'
on run argv
  display notification (item 1 of argv) with title (item 2 of argv) subtitle (item 3 of argv) sound name "Tink"
end run
APPLESCRIPT
