#!/bin/sh
# Runs mutator from its pinned checkout (.chezmoiexternal.toml). Used by the ub-mode skill.
# PYTHONSAFEPATH keeps `python -m` from putting the current folder on sys.path, so a
# module in the analysed project (crapper.py, tree_sitter/) cannot replace the tool's own.
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
export PYTHONSAFEPATH=1
exec "$HOME/.local/share/unclebob/mutator/mutator" "$@"
