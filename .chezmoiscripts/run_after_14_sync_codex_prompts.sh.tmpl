#!/usr/bin/env bash
# Mirror the Claude command library into ~/.codex/prompts as real files.
#
# Codex reads custom slash commands from ~/.codex/prompts. It SKIPS symlinks, silently:
# openai/codex#3637, #4383, #5040. So a symlinked directory or symlinked file shows
# nothing, and the only thing that works is a real file. This script copies instead.
#
# The copies are derived artifacts. ~/.claude/commands stays the single source of truth,
# and this script runs after every apply, so the two cannot drift for long.

set -eufo pipefail

CLAUDE_COMMANDS="${HOME}/.claude/commands"
CODEX_PROMPTS="${HOME}/.codex/prompts"
MANIFEST="${CODEX_PROMPTS}/.synced-from-claude"

[ -d "$CLAUDE_COMMANDS" ] || exit 0

# Only sync when Codex is actually set up on this machine.
[ -d "${HOME}/.codex" ] || exit 0

# An earlier version of this repo linked the directory. Codex ignores that, so replace it.
if [ -L "$CODEX_PROMPTS" ]; then
  rm -f "$CODEX_PROMPTS"
fi

mkdir -p "$CODEX_PROMPTS"

# Remove prompts this script wrote before that no longer exist in the command library.
# Files the manifest does not list are yours, and stay untouched.
if [ -f "$MANIFEST" ]; then
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if [ ! -f "${CLAUDE_COMMANDS}/${name}" ] && [ -f "${CODEX_PROMPTS}/${name}" ]; then
      rm -f "${CODEX_PROMPTS}/${name}"
    fi
  done < "$MANIFEST"
fi

NEW_MANIFEST=$(mktemp)
trap 'rm -f "$NEW_MANIFEST"' EXIT

# find, not a glob: the repo's `set -eufo pipefail` includes -f, which disables globbing.
while IFS= read -r src; do
  [ -f "$src" ] || continue
  name=$(basename "$src")
  dest="${CODEX_PROMPTS}/${name}"
  # cmp keeps the run idempotent: an unchanged prompt is not rewritten, so its mtime
  # and checksum stay put.
  if [ ! -f "$dest" ] || ! cmp -s "$src" "$dest"; then
    cp "$src" "$dest"
  fi
  printf '%s\n' "$name" >> "$NEW_MANIFEST"
done < <(find "$CLAUDE_COMMANDS" -maxdepth 1 -type f -name '*.md')

sort -o "$NEW_MANIFEST" "$NEW_MANIFEST"
if [ ! -f "$MANIFEST" ] || ! cmp -s "$NEW_MANIFEST" "$MANIFEST"; then
  cp "$NEW_MANIFEST" "$MANIFEST"
fi
