<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.barsotti.browser-reaper</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/browser-reaper</string>
  </array>

  <!-- Every 10 minutes, and at login. The script stops headless browsers
       that AI agents left running for more than 2 hours. -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/browser-reaper/launchd.out</string>

  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/browser-reaper/launchd.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
