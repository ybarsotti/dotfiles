{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5",
  "small_model": "openai/gpt-5.4-mini",
  "autoupdate": false,
  "plugin": [
    "opencode-anthropic-oauth@latest",
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@mohak34/opencode-notifier@latest",
    "@zenobius/opencode-skillful",
    // Removed 2026-07-22: fails to load with "Spread syntax requires
    // ...iterable not be null or undefined". Re-add when upstream fixes it.
    // "@plannotator/opencode@latest",
    "octto",
    "oh-my-openagent@latest"
  ],
  "provider": {
    "anthropic": {
      "models": {
        "claude-sonnet-5": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        },
        "claude-opus-4-8": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 32000
            }
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "medium"
          }
        },
        "gpt-5.4-mini": {
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low"
          }
        }
      }
    },
    // Local models through Ollama. Added so Paperclip's opencode_local agents can
    // run open-weight and stay off the Claude and Codex subscriptions. This block
    // is purely additive: `model` above still points at anthropic/claude-sonnet-5,
    // so interactive opencode is unchanged. Pick ollama/* explicitly to go local.
    // 127.0.0.1 rather than localhost: Ollama binds IPv4 only here, and localhost
    // resolves to ::1 first on macOS.
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      // `cost` here is NOT a price. Ollama bills nothing, so opencode would report
      // cost 0, Paperclip's spentMonthlyCents would never move, and a budget cap
      // would be decoration. Declaring a synthetic rate turns that budget into a
      // real stop condition — a token meter that happens to be denominated in
      // cents, which is the only unit Paperclip counts in.
      //
      // The rate is chosen so the arithmetic is legible, not so it matches any
      // vendor: at input 1.0 / output 5.0 USD per 1M tokens,
      //     1 cent = 10k input tokens, or 2k output tokens.
      // Output is weighted 5x on purpose: runaway generation is the failure mode
      // a cap exists to stop, so it should burn the budget faster.
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (local)",
          "cost": { "input": 1.0, "output": 5.0 }
        },
        "qwen2.5:14b": {
          "name": "Qwen2.5 14B (local)",
          "cost": { "input": 1.0, "output": 5.0 }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    // Disabled 2026-07-22: same defect as `ai-memory` below — gitnexus'
    // `api_impact` tool declares a top-level `anyOf`, which the Anthropic API
    // rejects, 400ing EVERY opencode request while this server is enabled.
    // opencode 1.14.30's `tools` config map does not filter MCP tools, so the
    // whole server has to go. gitnexus remains available via Claude Code's own
    // MCP config. Real fix is upstream: drop the top-level `anyOf`.
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "gitnexus@latest",
        "mcp"
      ],
      "enabled": false
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "codebuddy",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    // Disabled 2026-07-22: this server's `memory_read_page` tool declares a
    // top-level `anyOf` in its input schema. The Anthropic API rejects that
    // outright ("tools.N.custom.input_schema: input_schema does not support
    // oneOf, allOf, or anyOf at the top level"), so EVERY opencode request to
    // an Anthropic model 400s while this server is enabled. opencode 1.14.30's
    // `tools` config map does not filter MCP tools, so the whole server has to
    // go. Real fix is upstream: drop the top-level `anyOf` from that schema.
    "ai-memory": {
      "type": "remote",
      "url": "http://127.0.0.1:49374/mcp",
      "enabled": false
    }
  }
}
