    "display:order": 14,
    "icon": "hard-drive",
    "color": "#fab387",
    "label": "dust",
    "description": "dust - disk usage under ~/Developer",
    "blockdef": {
      "meta": {
        "view": "term",
        "controller": "cmd",
        "cmd": "/bin/zsh -lc 'dust -d 3'",
