{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "enableWorkflows": true,
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5": { "effortLevel": "medium" },
    "claude-opus-5-5": { "effortLevel": "medium" }
  },
  "theme": "custom:orca",
  "outputStyle": "Concise",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "denyInsteadOfPrompting": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "medium",
    "CLAUDE_CODE_DISABLE_AGENT_PROGRESS_SUMMARIES": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/keep-warm"{{ if env "CLAUDE_CODE_OAUTH_TOKEN" }},
    "CLAUDE_CODE_OAUTH_TOKEN": "{{ env "CLAUDE_CODE_OAUTH_TOKEN" }}"{{ end }}
  },
  "teammateMode": "auto",
  "subagentPromptCacheTtl": "1h",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
